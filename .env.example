# URL do Backend do Dashboard
# Use a URL do seu backend deployado no Render
# Exemplo: https://passa-bola-backend.render.com
VITE_BACKEND_URL=http://localhost:3000

# Para desenvolvimento local, use:
# VITE_BACKEND_URL=http://localhost:3000

# Para produção, use:
# VITE_BACKEND_URL=https://seu-backend.render.com

# ===== BYPASS DE AUTENTICAÇÃO (APENAS PARA DESENVOLVIMENTO) =====
# Ative para pular a tela de login e usar um usuário de teste
# Nunca ative em produção!
VITE_BYPASS_AUTH=true
